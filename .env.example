# Mercado Pago Credentials
MERCADOPAGO_PUBLIC_KEY=your-public-key
MERCADOPAGO_ACCESS_TOKEN=your-access-token
MERCADOPAGO_PUBLIC_KEY_TEST=your-test-public-key
MERCADOPAGO_ACCESS_TOKEN_TEST=your-test-access-token

# Webhook URLs
MERCADOPAGO_WEBHOOK_URL=https://your-production-domain.com/webhook
MERCADOPAGO_WEBHOOK_URL_TEST=https://your-test-domain.com/webhook

# Environment
NODE_ENV=development # or production 