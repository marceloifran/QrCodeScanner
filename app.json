{
  "expo": {
    "name": "Ifsin Negocios",
    "slug": "kiosko-app",
    "version": "1.0.0",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir que $(PRODUCT_NAME) acceda a tu cámara."
        }
      ],
      "expo-barcode-scanner",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#ffffff"
        }
      ]
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.marceloifran.kioskoapp",
      "buildNumber": "1.0.0",
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": ["qrcodescanner", "com.marceloifran.kioskoapp"],
            "CFBundleTypeRole": "Editor"
          }
        ],
        "LSApplicationQueriesSchemes": ["mercadopago"],
        "NSCameraUsageDescription": "Esta aplicación necesita acceso a la cámara para escanear códigos QR y códigos de barras.",
        "UIBackgroundModes": ["remote-notification"]
      },
      "associatedDomains": ["applinks:qrcodescanner.app.link"]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.marceloifran.kioskoapp",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "CAMERA",
        "RECEIVE_BOOT_COMPLETED",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "qrcodescanner"
            },
            {
              "scheme": "com.marceloifran.kioskoapp"
            },
            {
              "scheme": "https",
              "host": "*.qrcodescanner.app.link"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "qrcodescanner",
    "extra": {
      "eas": {
        "projectId": "c418f4af-b5b3-476e-97b8-3d17c2637b79"
      }
    }
  }
}
